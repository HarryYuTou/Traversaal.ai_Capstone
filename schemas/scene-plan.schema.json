{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-plan.schema.json",
  "$defs": {
    "Chapter": {
      "additionalProperties": false,
      "description": "A named run of consecutive scenes in a long video.",
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "sceneIds": {
          "items": {
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 60,
          "minItems": 1,
          "title": "Sceneids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "sceneIds"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "ComparisonColumn": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 24,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "points": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "label",
        "points"
      ],
      "title": "ComparisonColumn",
      "type": "object"
    },
    "ComparisonLine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "highlightSide": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlightside"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "ComparisonLine",
      "type": "object"
    },
    "ComparisonScene": {
      "additionalProperties": false,
      "description": "A title and two labelled columns that contrast two things, with up to three points each.",
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "template": {
          "const": "comparison",
          "title": "Template",
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/ComparisonVisual"
        },
        "narration": {
          "items": {
            "$ref": "#/$defs/ComparisonLine"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Narration",
          "type": "array"
        }
      },
      "required": [
        "id",
        "purpose",
        "template",
        "visual",
        "narration"
      ],
      "title": "ComparisonScene",
      "type": "object"
    },
    "ComparisonVisual": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ComparisonColumn"
        },
        "right": {
          "$ref": "#/$defs/ComparisonColumn"
        }
      },
      "required": [
        "title",
        "left",
        "right"
      ],
      "title": "ComparisonVisual",
      "type": "object"
    },
    "ConceptLine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "highlightPointIndex": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlightpointindex"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "ConceptLine",
      "type": "object"
    },
    "ConceptScene": {
      "additionalProperties": false,
      "description": "A title, one core statement and up to three points.",
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "template": {
          "const": "concept",
          "title": "Template",
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/ConceptVisual"
        },
        "narration": {
          "items": {
            "$ref": "#/$defs/ConceptLine"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Narration",
          "type": "array"
        }
      },
      "required": [
        "id",
        "purpose",
        "template",
        "visual",
        "narration"
      ],
      "title": "ConceptScene",
      "type": "object"
    },
    "ConceptVisual": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "statement": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "points": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "title",
        "statement"
      ],
      "title": "ConceptVisual",
      "type": "object"
    },
    "DefinitionLine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "highlightPart": {
          "anyOf": [
            {
              "enum": [
                "term",
                "definition",
                "example"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlightpart"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "DefinitionLine",
      "type": "object"
    },
    "DefinitionScene": {
      "additionalProperties": false,
      "description": "A title, one key term, its plain-language definition and an optional example.",
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "template": {
          "const": "definition",
          "title": "Template",
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/DefinitionVisual"
        },
        "narration": {
          "items": {
            "$ref": "#/$defs/DefinitionLine"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Narration",
          "type": "array"
        }
      },
      "required": [
        "id",
        "purpose",
        "template",
        "visual",
        "narration"
      ],
      "title": "DefinitionScene",
      "type": "object"
    },
    "DefinitionVisual": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "term": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "definition": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "example": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        }
      },
      "required": [
        "title",
        "term",
        "definition"
      ],
      "title": "DefinitionVisual",
      "type": "object"
    },
    "FlowLine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "highlightNodeId": {
          "anyOf": [
            {
              "maxLength": 48,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlightnodeid"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "FlowLine",
      "type": "object"
    },
    "FlowNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 24,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "FlowNode",
      "type": "object"
    },
    "FlowScene": {
      "additionalProperties": false,
      "description": "A title and two to four nodes connected in order.",
      "properties": {
        "id": {
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "template": {
          "const": "flow",
          "title": "Template",
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/FlowVisual"
        },
        "narration": {
          "items": {
            "$ref": "#/$defs/FlowLine"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Narration",
          "type": "array"
        }
      },
      "required": [
        "id",
        "purpose",
        "template",
        "visual",
        "narration"
      ],
      "title": "FlowScene",
      "type": "object"
    },
    "FlowVisual": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/FlowNode"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "title",
        "nodes"
      ],
      "title": "FlowVisual",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scene-by-scene script: what each scene shows and what the narrator says.",
  "properties": {
    "schemaVersion": {
      "const": "1",
      "title": "Schemaversion",
      "type": "string"
    },
    "projectId": {
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Projectid",
      "type": "string"
    },
    "title": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "scenes": {
      "items": {
        "discriminator": {
          "mapping": {
            "comparison": "#/$defs/ComparisonScene",
            "concept": "#/$defs/ConceptScene",
            "definition": "#/$defs/DefinitionScene",
            "flow": "#/$defs/FlowScene"
          },
          "propertyName": "template"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ConceptScene"
          },
          {
            "$ref": "#/$defs/FlowScene"
          },
          {
            "$ref": "#/$defs/ComparisonScene"
          },
          {
            "$ref": "#/$defs/DefinitionScene"
          }
        ]
      },
      "maxItems": 60,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "chapters": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Chapter"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chapters"
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "scenes"
  ],
  "title": "ScenePlan",
  "type": "object"
}
