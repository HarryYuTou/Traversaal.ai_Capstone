# Copy this template to .env for the Capstone planner.
# Put real credentials only in your ignored local .env, never in this example.
ANTHROPIC_API_KEY=

# Optional Level 2 video footage. This key never goes to the browser.
ARK_API_KEY=
# The only allowed video model. Do not set a different model or an endpoint ID.
ARK_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
