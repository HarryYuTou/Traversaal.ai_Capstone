      "narration": [
        {
          "id": "scene-01-line-01",
          "text": "Start with three people waiting. Assume equal service rounds; we will count completed rounds before the orange customer starts."
        },
        {
          "id": "scene-01-line-02",
          "text": "Only the first counter is open, so the first customer steps forward."
        },
        {
          "id": "scene-01-line-03",
          "text": "The first round finishes. The orange customer still waits behind one person."
        },
        {
          "id": "scene-01-line-04",
          "text": "The second customer moves forward. The orange customer stays in line."
        },
        {
          "id": "scene-01-line-05",
          "text": "A second service round finishes before the orange customer can move forward."
        },
        {
          "id": "scene-01-line-06",
          "text": "Now the orange customer starts, after waiting through two complete service rounds."
        },
        {
          "id": "scene-01-line-07",
          "text": "The second counter now opens. Next, replay the same arrivals with this extra capacity."
        }
