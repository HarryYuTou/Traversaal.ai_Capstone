      "narration": [
        {
          "id": "scene-01-line-01",
          "text": "Apollo solved a difficult problem: land on the Moon without taking the entire spacecraft down."
        },
        {
          "id": "scene-01-line-02",
          "text": "Two vehicles arrived together: an orbiter for the journey home, and a smaller lunar lander."
        },
        {
          "id": "scene-01-line-03",
          "text": "The lander separated and descended, while the orbiter continued circling above."
        },
        {
          "id": "scene-01-line-04",
          "text": "On the surface, the lander's lower stage became a stable platform for exploration."
        },
        {
          "id": "scene-01-line-05",
          "text": "Returning did not mean lifting that entire platform off the Moon."
        },
        {
          "id": "scene-01-line-06",
          "text": "Only the upper cabin launched, leaving the descent stage behind."
        },
        {
          "id": "scene-01-line-07",
          "text": "That cabin returned to orbit, caught up with the other spacecraft, and docked."
        },
        {
          "id": "scene-01-line-08",
          "text": "The crew transferred back, then discarded the lunar cabin before beginning the journey home."
        }
      ]
