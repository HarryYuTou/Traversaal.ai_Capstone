          "id": "scene-02-line-01",
          "text": "Now replay the same line, but open a second counter."
        },
        {
          "id": "scene-02-line-02",
          "text": "The first two shoppers start being served at the same time."
        },
        {
          "id": "scene-02-line-03",
          "text": "Both take the same time as before, side by side."
        },
        {
          "id": "scene-02-line-04",
          "text": "They finish together, and both leave."
        },
        {
          "id": "scene-02-line-05",
          "text": "The highlighted shopper starts after just one round instead of two."
        },
        {
          "id": "scene-02-line-06",
          "text": "Same shoppers, same service time, but two counters share the work, so waiting shrinks."
