      "narration": [
        {
          "id": "scene-01-line-01",
          "text": "Why does opening a second checkout counter cut waiting time? Let's watch."
        },
        {
          "id": "scene-01-line-02",
          "text": "Three shoppers are waiting, and only one counter is open."
        },
        {
          "id": "scene-01-line-03",
          "text": "The first shopper steps up and starts being served."
        },
        {
          "id": "scene-01-line-04",
          "text": "Let's assume every shopper takes the same amount of time."
        },
        {
          "id": "scene-01-line-05",
          "text": "When she is done, she leaves, and the line can move."
        },
        {
          "id": "scene-01-line-06",
          "text": "Now the second shopper starts, while the highlighted shopper keeps waiting."
        },
        {
          "id": "scene-01-line-07",
          "text": "The second shopper finishes and leaves after another full service."
        },
        {
          "id": "scene-01-line-08",
          "text": "With one counter, the highlighted shopper waits two whole rounds before her turn."
        }
      ]
